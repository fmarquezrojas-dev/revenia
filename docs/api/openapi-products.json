{
  "openapi": "3.1.0",
  "info": {
    "title": "Facturly - Productos y servicios",
    "version": "1.0.0",
    "description": "Contrato del modulo Productos. Sanctum por cookie; escrituras requieren CSRF. Owner/issuer escriben, accountant consulta. company_id, id y fechas prohibidos en escrituras; company_id tambien prohibido en consultas. Campos desconocidos se ignoran. No DELETE."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/v1/products": {
      "get": {
        "summary": "Listar por empresa, orden description e id",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "links",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "links": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "meta": {
                      "type": "object",
                      "required": [
                        "current_page",
                        "last_page",
                        "per_page",
                        "total"
                      ],
                      "properties": {
                        "current_page": {
                          "type": "integer"
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sin sesion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso sobre recurso propio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso ajeno o inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "CSRF vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validacion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "is_active",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PEN",
                "USD"
              ]
            }
          },
          {
            "name": "tax_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "10",
                "20",
                "30"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 15
            }
          }
        ]
      },
      "post": {
        "summary": "Crear activo",
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Product"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sin sesion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso sobre recurso propio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso ajeno o inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "CSRF vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validacion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductCreate"
              }
            }
          }
        }
      }
    },
    "/api/v1/products/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Consultar detalle propio",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Product"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sin sesion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso sobre recurso propio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso ajeno o inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "CSRF vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validacion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Editar o cambiar estado",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Product"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sin sesion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso sobre recurso propio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso ajeno o inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "CSRF vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validacion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductUpdate"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "laravel_session",
        "description": "Nombre real configurable por SESSION_COOKIE. GET /sanctum/csrf-cookie antes de escribir; enviar X-XSRF-TOKEN."
      }
    },
    "schemas": {
      "ProductCreate": {
        "type": "object",
        "required": [
          "code",
          "description",
          "unit_code",
          "currency",
          "unit_price_cents",
          "tax_type"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "description": "Trim exterior y mayusculas; unico por empresa."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "unit_code": {
            "type": "string",
            "enum": [
              "NIU",
              "ZZ"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "PEN",
              "USD"
            ]
          },
          "unit_price_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Precio unitario sin IGV, entero JSON; no strings ni fracciones."
          },
          "tax_type": {
            "type": "string",
            "enum": [
              "10",
              "20",
              "30"
            ]
          },
          "company_id": false,
          "id": false,
          "created_at": false,
          "updated_at": false,
          "is_active": false
        }
      },
      "ProductUpdate": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "description": "Trim exterior y mayusculas; unico por empresa."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "unit_code": {
            "type": "string",
            "enum": [
              "NIU",
              "ZZ"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "PEN",
              "USD"
            ]
          },
          "unit_price_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Precio unitario sin IGV, entero JSON; no strings ni fracciones."
          },
          "tax_type": {
            "type": "string",
            "enum": [
              "10",
              "20",
              "30"
            ]
          },
          "is_active": {
            "type": "boolean"
          },
          "company_id": false,
          "id": false,
          "created_at": false,
          "updated_at": false
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "code",
          "description",
          "unit_code",
          "currency",
          "unit_price_cents",
          "tax_type",
          "id",
          "is_active",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "description": "Trim exterior y mayusculas; unico por empresa."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "unit_code": {
            "type": "string",
            "enum": [
              "NIU",
              "ZZ"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "PEN",
              "USD"
            ]
          },
          "unit_price_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Precio unitario sin IGV, entero JSON; no strings ni fracciones."
          },
          "tax_type": {
            "type": "string",
            "enum": [
              "10",
              "20",
              "30"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_active": {
            "type": "boolean"
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
