APP_NAME=Revenia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=facturly
DB_USERNAME=facturly
DB_PASSWORD=facturly_local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="demo@facturly.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Private document delivery: production must set a controlled test recipient.
DELIVERY_QUEUE_CONNECTION=redis
DOCUMENT_DEMO_RECIPIENT=
# Optional absolute shared private directory; defaults to storage/app/private/documents.
# DOCUMENT_STORAGE_ROOT=/app/storage/app/private/documents

# Demonstration payments: disabled until all test settings are supplied.
# Odoo Community 18.0. Exact deployment-owned origins and databases, e.g. {"local":{"url":"http://odoo:8069","database":"revenia"}}
ODOO_ENABLED=false
ODOO_ENDPOINTS='{}'

MP_SANDBOX_ENABLED=false
# Receptor exclusivo de suscripciones a Revenia. Cada comercio se vincula en Configuración → Cobros.
MP_TEST_ACCESS_TOKEN=
MP_TEST_COLLECTOR_ID=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=
MP_RETURN_ORIGIN=
PAYMENT_QUEUE_CONNECTION=redis

# Legacy operational namespaces: keep existing sessions, queues and locks.
SESSION_COOKIE=facturly-session
CACHE_PREFIX=facturly-cache-
REDIS_PREFIX=facturly-database-
HORIZON_PREFIX=facturly_horizon:

# Local SPA origin; not a production domain.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
SIMULATION_DEMO_CONTROLS=true
